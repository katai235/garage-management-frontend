{
  "expo": {
    "name": "Sam Saen Thai KT Lo,. Co",
    "slug": "garage-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF2FF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.samsenthai.garagemanagement",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to securely sign in to Garage Management",
        "NSCameraUsageDescription": "Access camera to scan QR codes and take photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.samsenthai.garagemanagement",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Sam Saen Thai KT Lo,. Co",
      "shortName": "GMS",
      "description": "Garage Management System by Sam Saen Thai KT Lo,. Co",
      "themeColor": "#2563EB",
      "backgroundColor": "#EEF2FF"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "25da6a5b-7d22-4188-8d5d-86ea3d43384b"
      }
    },
    "owner": "nyoko"
  }
}
